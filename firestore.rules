rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isApproved() {
      return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /admins/{uid} { allow read: if signed() && request.auth.uid == uid; allow write: if false; }

    match /users/{uid} {
      allow read: if isAdmin() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name','phone','status','createdAt']);
      allow update, delete: if isAdmin();
    }

    match /settings/{id} { allow read: if signed(); allow write: if isAdmin(); }

    match /products/{id} { allow read: if isAdmin() || isApproved(); allow write: if isAdmin(); }
    match /costs/{id} { allow read, write: if isAdmin(); }
    match /sales/{id} { allow read, write: if isAdmin(); }

    match /orders/{id} {
      allow read: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow update, delete: if isAdmin();
    }
  }
}
